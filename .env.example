# Kopyalayın: cp .env.example .env.local   (Docker için: .env)
# Hiçbiri zorunlu değil; varsayılanlar backend'in yerelde :5000'de çalıştığını varsayar.

# Tarayıcının API'ye gittiği adres (sonunda / olmadan)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Sunucu tarafı (SSR) isteklerinin gittiği adres. Boşsa NEXT_PUBLIC_API_URL kullanılır.
# Docker'da varsayılanı http://host.docker.internal:5000 (docker-compose.yml)
# API_INTERNAL_URL=
